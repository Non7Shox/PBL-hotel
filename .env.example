# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Telegram-бот: токен от @BotFather и имя бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ID чата ресепшн: добавьте бота в группу и отправьте там /chatid
TELEGRAM_STAFF_CHAT_ID=

# Час утренней сводки по времени Ташкента
TELEGRAM_DIGEST_HOUR=8

# Адрес сайта для ссылок в сообщениях бота
DJANGO_SITE_URL=http://127.0.0.1:8001

# Основной домен для production: https://bookbreinhotel.me
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,bookbreinhotel.me,www.bookbreinhotel.me
DJANGO_CSRF_TRUSTED_ORIGINS=https://bookbreinhotel.me,https://www.bookbreinhotel.me,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# OAuth client в Google Cloud Console. Добавьте callback URL
# https://bookbreinhotel.me/accounts/google/callback/
# и для локального теста http://127.0.0.1:8001/accounts/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Почта: SMTP либо API провайдера. API ожидает POST JSON {to, subject, message}
# с Authorization: Bearer <EMAIL_API_TOKEN>.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Aurelio Hotel <no-reply@bookbreinhotel.me>
EMAIL_API_TOKEN=
EMAIL_API_URL=

# SMS API ожидает POST JSON {to, message} с Authorization: Bearer <SMS_API_TOKEN>.
SMS_API_TOKEN=
SMS_API_URL=

# Одноразовые коды
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Тестовая симуляция никогда не списывает деньги.
PAYMENT_GATEWAY=simulation
# Включайте только для локального/учебного теста. В production оставьте False.
PAYMENT_SIMULATION_ENABLED=True

# Файл Apple Pay Domain Verification выдается Apple после настройки merchant ID.
# Укажите полный путь к скачанному файлу на сервере. Реальные платежи не подключены.
APPLE_PAY_DOMAIN_ASSOCIATION_PATH=
