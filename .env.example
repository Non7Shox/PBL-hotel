# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Telegram-бот: токен от @BotFather и имя бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ID чата ресепшн: добавьте бота в группу и отправьте там /chatid
TELEGRAM_STAFF_CHAT_ID=

# Час утренней сводки по времени Ташкента
TELEGRAM_DIGEST_HOUR=8

# Адрес сайта для ссылок в сообщениях бота
DJANGO_SITE_URL=http://127.0.0.1:8001
